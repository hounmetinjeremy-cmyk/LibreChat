# À remplir, puis enregistrer sous le nom .env (dans ce même dossier).
# Ne jamais publier le fichier .env.

# Adresse publique de ton serveur (IP de la VM, ou ton domaine)
DOMAIN_CLIENT=http://ADRESSE_DE_TA_VM
DOMAIN_SERVER=http://ADRESSE_DE_TA_VM
ALLOW_REGISTRATION=true

# Clés de LibreChat : génère chaque valeur avec la commande indiquée dans le README
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Gemini : la clé est saisie dans l'interface par chaque utilisateur
GOOGLE_KEY=user_provided

# Service dev-fix (un dev par utilisateur : chacun saisit son propre token GitHub dans LibreChat)
MCP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Corrections en même temps sur le serveur, et plafond par utilisateur et par jour
MAX_PARALLEL=3
MAX_FIX_PER_DAY=20
