# À remplir, puis enregistrer sous le nom .env (dans ce même dossier).
# Ne jamais publier le fichier .env.

# Adresse publique de ton serveur (IP de la VM, ou ton domaine)
DOMAIN_CLIENT=http://ADRESSE_DE_TA_VM
DOMAIN_SERVER=http://ADRESSE_DE_TA_VM
ALLOW_REGISTRATION=true

# Clés de LibreChat : génère chaque valeur avec la commande indiquée dans le README
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Gemini : la clé est saisie dans l'interface par chaque utilisateur
GOOGLE_KEY=user_provided

# Abonnement : les tokens sont payés avec TES clés (inclus dans l'abonnement).
# Format attendu par le modèle « Jérémy » : clé_deepseek,clé_gemini (séparées par une virgule)
VISION_KEYS=

# Limite de messages : 80 par utilisateur et par jour (fenêtre de 1440 minutes = 24 h)
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=80
MESSAGE_USER_WINDOW=1440

# Service dev-fix (un dev par utilisateur : chacun saisit son propre token GitHub dans LibreChat)
MCP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Corrections en même temps sur le serveur
MAX_PARALLEL=3
# Budget de tokens des corrections, par utilisateur et par mois (en dollars)
FIX_BUDGET_USD=1
# Prix par million de tokens (à vérifier sur ton compte DeepSeek)
DS_PRICE_IN=0.14
DS_PRICE_OUT=0.28
